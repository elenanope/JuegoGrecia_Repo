MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2098914886}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5d1e489ff08a5d94796ee26c72e40b90, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  avisoDialogo: {fileID: 1506592802}
  otherPanel: {fileID: 1347955603}
  otherText: {fileID: 1347955602}
  lastLine: 0
  dialogueLines:
  - Hey, hey! What are you doing here??
  - Looking for a wild pig, you say? I saw one just a moment ago. He was holding
    a lyre between his teeth.
  - But I am not helping you for free, as if I hadn't work hard to get to where I
    am! I could get in trouble...
  - Now that I think about it, people bring in offerings for the Gods, but they all
    end up lost in the temple.
  - If you get me 10 drachmas I will take you to where that wild pig went.
  - Oh, yes, you will find some of my colleagues, but you can get rid of them. They
    are useless...
  - What are you waiting for? Do you want me to kick you out? Bring me 10 drachmas,
    c'mon!!
